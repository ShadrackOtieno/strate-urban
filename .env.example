APP_NAME="Kilele Properties"
APP_ENV=local
APP_KEY=base64:ZNU1qb4U+Ogd63PzbQD/Fuif9hFSv+/VM5nNdX1CFtA=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL (WAMP/XAMPP). Create an empty database with this name in phpMyAdmin, or change the name here.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=strateurban
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Back-office login created by the seeder.
ADMIN_EMAIL=admin@kilele.test
ADMIN_PASSWORD=ChangeMe-2026!

# "log" writes enquiry notifications to storage/logs/laravel.log. Use smtp for real email.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@kilele.test"
MAIL_FROM_NAME="${APP_NAME}"
